<!DOCTYPE html>
<html lang="<%- config.language || 'zh-CN' %>" data-theme="auto">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%- page.title ? page.title + ' · ' + config.title : config.title %></title>
  <meta name="description" content="<%- page.description || config.description || config.title %>">
  <% if (theme.favicon) { %>
  <link rel="icon" href="<%- url_for(theme.favicon) %>">
  <% } %>
  <link rel="stylesheet" href="<%- url_for('/css/main.css') %>">
  <link rel="alternate" type="application/rss+xml" title="<%= config.title %>" href="<%- url_for('/atom.xml') %>">
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <div class="brand">
        <a class="site-name" href="<%- url_for('/') %>"><%= config.title %></a>
      </div>
      <nav class="site-nav">
        <% for (var name in theme.menu) {
          var p = theme.menu[name].replace(/^\//, '');
          var isActive = p === ''
            ? (page.path === '' || page.path === 'index.html')
            : (page.path && page.path.indexOf(p) === 0);
        %>
        <a class="nav-link<%- isActive ? ' active' : '' %>" href="<%- url_for(theme.menu[name]) %>"><%= name %></a>
        <% } %>
      </nav>
      <button class="theme-toggle" id="themeToggle" aria-label="切换主题" title="切换深浅色">◐</button>
    </div>
  </header>

  <div class="container layout">
    <% if (theme.sidebar && theme.sidebar.enable) { %>
    <aside class="sidebar">
      <div class="sidebar-card">
        <div class="sidebar-avatar">
          <% if (theme.sidebar.avatar) { %>
          <img src="<%- url_for(theme.sidebar.avatar) %>" alt="<%= config.title %>">
          <% } else { %>
          <span><%= (config.title || '?').trim().charAt(0) %></span>
          <% } %>
        </div>
        <div class="sidebar-name"><%= config.title %></div>
        <% if (theme.sidebar.slogan) { %>
        <div class="sidebar-slogan"><%= theme.sidebar.slogan %></div>
        <% } %>
        <% if (theme.sidebar.bio) { %>
        <div class="sidebar-bio"><%= theme.sidebar.bio %></div>
        <% } %>
        <% if (theme.sidebar.social) { %>
        <div class="sidebar-social">
          <% for (var sname in theme.sidebar.social) { %>
          <a class="social-link" href="<%- theme.sidebar.social[sname] %>" target="_blank" rel="noopener"><%= sname %></a>
          <% } %>
        </div>
        <% } %>
      </div>
    </aside>
    <% } %>

    <main class="site-main">
      <%- body %>
    </main>
  </div>

  <footer class="site-footer">
    <div class="container">
      <p>© <%= new Date().getFullYear() %> <%= config.author || config.title %>. 保留所有权利。</p>
      <% if (theme.copyright) { %>
      <p><%= theme.copyright %></p>
      <% } %>
    </div>
  </footer>

  <script src="<%- url_for('/js/main.js') %>"></script>
</body>
</html>
