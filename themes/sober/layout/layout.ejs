<!DOCTYPE html>
<html lang="<%- config.language || 'zh-CN' %>" data-theme="auto" data-color="blue">
<%
var sb = theme.sidebar || {};
var menu = theme.menu || {};
var dyn = theme.dynamics || {};
var ft = theme.footer || {};
var title = config.title || '';
var handle = '';
if (sb.github) { handle = String(sb.github).split('/').pop() || ''; }
var isHome = page.__index === true;
var dynItems = [];
try { dynItems = (typeof all_dynamics === 'function') ? (all_dynamics() || []) : []; } catch (e) { dynItems = []; }
var icons = {'首页':'🏠','文章':'📝','标签':'🏷️','分类':'📂','归档':'🗂️','友链':'🤝','关于':'👤','动态':'⚡'};
%>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%- (page.title ? page.title + ' · ' : '') + title %></title>
  <meta name="description" content="<%- page.description || config.description || title %>">
  <% if (theme.favicon) { %><link rel="icon" href="<%- url_for(theme.favicon) %>"><% } %>
  <link rel="stylesheet" href="<%- url_for('/css/main.css') %>?v=16">
  <link rel="stylesheet" href="<%- url_for('/css/dynamic-extra.css') %>?v=3">
  <link rel="stylesheet" href="<%- url_for('/css/color-search.css') %>?v=5">
  <link rel="alternate" type="application/rss+xml" title="<%= title %>" href="<%- url_for('/atom.xml') %>">
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <div class="brand">
        <a class="site-name" href="<%- url_for('/') %>"><%= title %></a>
        <span class="site-subtitle"><%= config.subtitle || sb.description || '' %></span>
      </div>
      <div class="header-actions">
        <button class="search-toggle" id="searchToggle" title="搜索">🔍</button>
        <button class="color-toggle" id="colorToggle" title="配色">🎨</button>
        <button class="theme-toggle" id="themeToggle" title="深浅色">◐</button>
        <button class="menu-toggle" id="menuToggle" title="菜单">☰</button>
      </div>
    </div>
  </header>

  <div class="color-overlay" id="colorOverlay"></div>
  <div class="color-pop" id="colorPop">
    <div class="color-pop-title">🎨 选择强调色</div>
    <div class="color-options" id="colorOptions">
      <button class="color-option active" data-color="blue" style="background:linear-gradient(135deg,#3b82f6,#0ea5e9)" title="蓝"></button>
      <button class="color-option" data-color="teal" style="background:linear-gradient(135deg,#0d9488,#14b8a6)" title="青"></button>
      <button class="color-option" data-color="orange" style="background:linear-gradient(135deg,#ea580c,#f59e0b)" title="橙"></button>
      <button class="color-option" data-color="violet" style="background:linear-gradient(135deg,#7c3aed,#a78bfa)" title="紫"></button>
      <button class="color-option" data-color="rose" style="background:linear-gradient(135deg,#e11d48,#fb7185)" title="粉"></button>
    </div>
  </div>

  <div class="search-overlay" id="searchOverlay">
    <div class="search-panel">
      <div class="search-input-wrap">
        <span class="search-icon">🔍</span>
        <input class="search-input" id="searchInput" type="text" placeholder="搜索…" autocomplete="off">
        <button class="search-close" id="searchClose">✕</button>
      </div>
      <div class="search-results" id="searchResults"><div class="search-empty">输入关键词开始搜索…</div></div>
    </div>
  </div>

  <nav class="menu-panel" id="menuPanel">
    <div class="container">
      <ul class="menu-list">
        <% for (var name in menu) {
          var p = String(menu[name] || '').replace(/^\//, '');
          var isActive = (p === '') ? (page.path === '' || page.path === 'index.html') : (page.path && page.path.indexOf(p) === 0);
        %>
        <li class="menu-item<%- isActive ? ' active' : '' %>">
          <a href="<%- url_for(menu[name]) %>"><span class="menu-icon"><%= icons[name] || '•' %></span><%= name %></a>
        </li>
        <% } %>
      </ul>
    </div>
  </nav>
  <div class="menu-overlay" id="menuOverlay"></div>

  <div class="container layout">
    <% if (sb.enable) { %>
    <aside class="sidebar">
      <div class="sidebar-card">
        <div class="sidebar-avatar">
          <% if (sb.avatar) { %><img src="<%- url_for(sb.avatar) %>" alt="avatar"><% } else { %><span class="avatar-fallback"><%= (config.author || title || '?').charAt(0) %></span><% } %>
        </div>
        <div class="sidebar-name"><%= config.author || title %></div>
        <div class="sidebar-desc"><%= config.subtitle || sb.description || '' %></div>
        <% if (handle) { %><a class="sidebar-github" href="<%- sb.github %>" target="_blank" rel="noopener">🐙 GitHub - @<%= handle %></a><% } %>
        <% if (sb.bio) { %><div class="sidebar-bio"><%= sb.bio %></div><% } %>
      </div>
      <% if (isHome && dynItems.length) { %>
      <div class="sidebar-card sidebar-dynamics-card">
        <div class="sidebar-card-title">⚡ 最新动态</div>
        <div class="sidebar-dynamics-scroll">
          <% dynItems.slice(0, sb.dynamics_count || 8).forEach(function(item){ %>
          <div class="sidebar-dynamic">
            <div class="sidebar-dynamic-date">🗓 <%= ddate(item.date) %></div>
            <% if (item.title && item.title !== '未命名') { %><div class="sidebar-dynamic-title">💬 <%= item.title %></div><% } %>
            <div class="sidebar-dynamic-content"><%- item.raw ? md(item.content) : item.content %></div>
          </div>
          <% }) %>
        </div>
        <a class="sidebar-dynamics-more" href="<%- url_for(dyn.more_link || '/dynamics/') %>">查看更多动态 →</a>
      </div>
      <% } %>
    </aside>
    <% } %>
    <main class="site-main"><%- body %></main>
  </div>

  <footer class="site-footer">
    <div class="container">
      <p>© <%= new Date().getFullYear() %> <%= config.author || title %>. 保留所有权利。</p>
      <% if (ft.copyright) { %><p><%= ft.copyright %></p><% } %>
    </div>
  </footer>

  <script src="<%- url_for('/js/main.js') %>?v=9"></script>
  <script src="<%- url_for('/js/search.js') %>?v=4"></script>
</body>
</html>
