<!DOCTYPE html>
<html lang="<%- config.language || 'zh-CN' %>" data-theme="auto" data-bg="blue">
<%
  var handle = '';
  if (theme.sidebar && theme.sidebar.github) {
    handle = theme.sidebar.github.split('/').pop();
  }
  var brandName = config.title + (handle ? ' / @' + handle : '');
  var isHome = page.__index === true;
  var dynItems = all_dynamics();
  // 菜单小图标映射（无图标库，用 emoji 零依赖）
  var menuIcons = {
    '首页': '🏠',
    '文章': '📝',
    '标签': '🏷️',
    '分类': '📂',
    '归档': '🗂️',
    '友链': '🤝',
    '关于': '👤',
    '动态': '⚡'
  };
%>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%- page.title ? page.title + ' · ' + brandName : brandName %></title>
  <meta name="description" content="<%- page.description || config.description || config.title %>">
  <% if (theme.favicon) { %>
  <link rel="icon" href="<%- url_for(theme.favicon) %>">
  <% } %>
  <link rel="stylesheet" href="<%- url_for('/css/main.css') ?>?v=11">
  <link rel="stylesheet" href="<%- url_for('/css/dynamic-extra.css') ?>?v=3">
  <link rel="stylesheet" href="<%- url_for('/css/color-search.css') ?>?v=2">
  <link rel="alternate" type="application/rss+xml" title="<%= config.title %>" href="<%- url_for('/atom.xml') %>">
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <div class="brand">
        <a class="site-name" href="<%- url_for('/') %>"><%= brandName %></a>
        <span class="site-subtitle"><%= config.subtitle || theme.sidebar.description %></span>
      </div>
      <div class="header-actions">
        <button class="search-toggle" id="searchToggle" aria-label="搜索" title="搜索">🔍</button>
        <button class="color-toggle" id="colorToggle" aria-label="切换配色" title="切换配色">🎨</button>
        <button class="theme-toggle" id="themeToggle" aria-label="切换主题" title="切换深浅色">◐</button>
        <button class="menu-toggle" id="menuToggle" aria-label="菜单" title="菜单">☰</button>
      </div>
    </div>
  </header>

  <!-- 配色选择面板（整套背景渐变方案） -->
  <div class="color-overlay" id="colorOverlay"></div>
  <div class="color-pop" id="colorPop">
    <div class="color-pop-title">🎨 选择背景配色</div>
    <div class="color-options" id="colorOptions">
      <button class="color-option active" data-bg="blue" style="background: linear-gradient(135deg,#eaf2ff,#f2eeff,#ffeef6)" title="晨曦蓝紫"></button>
      <button class="color-option" data-bg="teal" style="background: linear-gradient(135deg,#e6f7f3,#eef7ef,#e9f5f0)" title="薄荷青绿"></button>
      <button class="color-option" data-bg="peach" style="background: linear-gradient(135deg,#fff3ea,#fff0f2,#fef3e2)" title="蜜桃暖橙"></button>
      <button class="color-option" data-bg="violet" style="background: linear-gradient(135deg,#f0ecff,#f3efff,#f7f0ff)" title="星夜紫罗兰"></button>
      <button class="color-option" data-bg="rose" style="background: linear-gradient(135deg,#fff0f5,#ffeef1,#fdf0ff)" title="樱花粉"></button>
    </div>
  </div>

  <!-- 搜索面板 -->
  <div class="search-overlay" id="searchOverlay">
    <div class="search-panel">
      <div class="search-input-wrap">
        <span class="search-icon">🔍</span>
        <input class="search-input" id="searchInput" type="text" placeholder="搜索文章标题 / 标签 / 内容…" autocomplete="off">
        <button class="search-close" id="searchClose" aria-label="关闭">✕</button>
      </div>
      <div class="search-results" id="searchResults">
        <div class="search-empty">输入关键词开始搜索…</div>
      </div>
    </div>
  </div>

  <!-- 汉堡菜单（收进所有导航） -->
  <nav class="menu-panel" id="menuPanel">
    <div class="container">
      <ul class="menu-list">
        <% for (var name in theme.menu) {
          var p = theme.menu[name].replace(/^\//, '');
          var isActive = p === ''
            ? (page.path === '' || page.path === 'index.html')
            : (page.path && page.path.indexOf(p) === 0);
        %>
        <li class="menu-item<%- isActive ? ' active' : '' %>">
          <a href="<%- url_for(theme.menu[name]) %>">
            <span class="menu-icon"><%= menuIcons[name] || '•' %></span><%= name %>
          </a>
        </li>
        <% } %>
      </ul>
    </div>
  </nav>
  <div class="menu-overlay" id="menuOverlay"></div>

  <div class="container layout">
    <% if (theme.sidebar && theme.sidebar.enable) { %>
    <aside class="sidebar">
      <!-- 资料卡片（所有页面显示） -->
      <div class="sidebar-card">
        <div class="sidebar-avatar">
          <% if (theme.sidebar.avatar) { %>
          <img src="<%- url_for(theme.sidebar.avatar) %>" alt="avatar">
          <% } else { %>
          <span class="avatar-fallback"><%= (config.author || config.title).charAt(0) %></span>
          <% } %>
        </div>
        <div class="sidebar-name"><%= config.author || config.title %></div>
        <div class="sidebar-desc"><%= config.subtitle || theme.sidebar.description %></div>
        <% if (handle) { %>
        <a class="sidebar-github" href="<%= theme.sidebar.github %>" target="_blank" rel="noopener">🐙 GitHub - @<%= handle %></a>
        <% } %>
        <% if (theme.sidebar.bio) { %>
        <div class="sidebar-bio"><%= theme.sidebar.bio %></div>
        <% } %>
      </div>

      <!-- 最新动态卡片（内嵌可滚动框，只在首页显示） -->
      <% if (isHome && dynItems.length) { %>
      <div class="sidebar-card sidebar-dynamics-card">
        <div class="sidebar-card-title">⚡ 最新动态</div>
        <div class="sidebar-dynamics-scroll">
          <% dynItems.slice(0, theme.sidebar.dynamics_count || 8).forEach(function(item){ %>
          <div class="sidebar-dynamic">
            <div class="sidebar-dynamic-date">🗓 <%= ddate(item.date) %></div>
            <% if (item.title && item.title !== '未命名') { %><div class="sidebar-dynamic-title">💬 <%= item.title %></div><% } %>
            <% if (item.raw) { %>
            <div class="sidebar-dynamic-content"><%- md(item.content) %></div>
            <% } else { %>
            <div class="sidebar-dynamic-content"><%- item.content %></div>
            <% } %>
          </div>
          <% }) %>
        </div>
        <a class="sidebar-dynamics-more" href="<%- url_for(theme.dynamics.more_link || '/dynamics/') %>">查看更多动态 →</a>
      </div>
      <% } %>
    </aside>
    <% } %>

    <main class="site-main">
      <%- body %>
    </main>
  </div>

  <footer class="site-footer">
    <div class="container">
      <p>© <%= new Date().getFullYear() %> <%= config.author || config.title %>. 保留所有权利。</p>
      <% if (theme.footer && theme.footer.copyright) { %>
      <p><%= theme.footer.copyright %></p>
      <% } %>
    </div>
  </footer>

  <script src="<%- url_for('/js/main.js') ?>?v=9"></script>
  <script src="<%- url_for('/js/search.js') ?>?v=2"></script>
</body>
</html>
