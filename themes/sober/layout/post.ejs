<article class="post">
  <header class="post-header">
    <h1 class="post-title"><%= page.title %></h1>
    <div class="post-meta">
      <time datetime="<%= date(page.date, 'YYYY-MM-DD') %>"><%= date(page.date, 'YYYY-MM-DD') %></time>
      <% if (page.tags && page.tags.length) { %>
      <span class="post-tags">
        <% page.tags.each(function(tag){ %>
        <a href="<%- url_for(tag.path) %>">#<%= tag.name %></a>
        <% }) %>
      </span>
      <% } %>
    </div>
  </header>
  <div class="post-content">
    <%- page.content %>
  </div>
  <% if (page.prev || page.next) { %>
  <nav class="post-nav">
    <% if (page.prev) { %><a class="post-nav-prev" href="<%- url_for(page.prev.path) %>">← <%= page.prev.title %></a><% } %>
    <% if (page.next) { %><a class="post-nav-next" href="<%- url_for(page.next.path) %>"><%= page.next.title %> →</a><% } %>
  </nav>
  <% } %>
</article>
