<h1 class="page-title">分类：<%= page.category ? page.category.name : '' %></h1>
<div class="archive-list">
  <% page.posts.each(function(post){ %>
  <div class="archive-item">
    <time datetime="<%= date(post.date, 'YYYY-MM-DD') %>"><%= date(post.date, 'YYYY-MM-DD') %></time>
    <a href="<%- url_for(post.path) %>"><%= post.title %></a>
    <span class="archive-meta">
      <% if (post.tags && post.tags.length) { %>#<%= post.tags.map(function(t){ return t.name; }).join(' #') %><% } %>
    </span>
  </div>
  <% }) %>
</div>
<% if (page.total > 1) { %>
<nav class="pagination">
  <%- paginator({ prev_text: '← 上一页', next_text: '下一页 →' }) %>
</nav>
<% } %>
