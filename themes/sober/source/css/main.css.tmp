/* ============ 响应式 ============ */
/* 侧边栏固定左侧：只在窄于 640px（手机）时才折叠到顶部 */
@media (max-width: 640px) {
  .layout { flex-direction: column; gap: 24px; }
  .sidebar {
    width: 100%;
    position: static;
    padding: 20px 0 0;
    flex-direction: column;
  }
  .sidebar-card { min-width: 0; }
  .site-main { padding-top: 8px; }
  .header-inner { height: auto; padding: 14px 0; }
  .site-nav { order: 3; width: 100%; justify-content: flex-start; }
  .post-header .post-title { font-size: 24px; }
  .archive-item { flex-wrap: wrap; }
  .archive-meta { margin-left: 0; text-align: left; width: 100%; }
  .friends-list { grid-template-columns: 1fr; }
}
